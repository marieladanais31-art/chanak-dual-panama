{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "cleanUrls": false,
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/en/?$", "dest": "/en/index.html" },
    { "src": "^/gracias/?$", "dest": "/gracias/index.html" },
    { "src": "^/en/thank-you/?$", "dest": "/en/thank-you/index.html" }
  ]
}
